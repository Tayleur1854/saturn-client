{
  "schemaVersion": 1,
  "name": "Saturn Client",
  "id": "saturn-client",
  "version": "${version}",
  "description": "Based utility mod. Modified by Bills310",
  "authors": ["Bills310"],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/Bills310/saturn-client"
  },
  "license": "GPL-3.0",
  "icon": "assets/saturn-client/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "saturndevelopment.saturnclient.SaturnClient"
    ],
    "modmenu": [
      "saturndevelopment.saturnclient.modintegration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "saturn-client.mixins.json",
    "saturn-client-baritone.mixins.json",
    "saturn-client-indigo.mixins.json",
    "saturn-client-sodium.mixins.json",
    "saturn-client-lithium.mixins.json",
    "saturn-client-viafabricplus.mixins.json"
  ],
  "accessWidener": "saturn-client.accesswidener",
  "custom": {
    "saturn-client:build_number": "${build_number}",
    "saturn-client:color": "145,61,226",
    "saturn-client:commit": "${commit}",
    "modmenu": {
      "links": {
        "modmenu.discord": ""
      }
    },
    "badoptimizations:cache_hooks": {
      "lightmap": "saturndevelopment.saturnclient.modintegration.BadOptimizationsHook"
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${minecraft_version}"],
    "fabricloader": ">=${loader_version}"
  },
  "breaks": {
    "optifabric": "*",
    "feather": "*",
    "origins": "*",
    "sodium": "<0.7.0",
    "morechathistory": "*",
    "lithium": "<0.21.3"
  }
}
